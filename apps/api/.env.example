# ===== Server =====
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://studybuddy:changeme@localhost:5432/studybuddy?schema=public

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT =====
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=30d
JWT_REMEMBER_ME_EXPIRES_IN=90d

# ===== Email (Hostinger SMTP) =====
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=Study Buddy
SMTP_FROM_EMAIL=your-email@yourdomain.com

# ===== Google OAuth (placeholder for now) =====
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ===== Gemini AI (placeholder for now) =====
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ===== App =====
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6