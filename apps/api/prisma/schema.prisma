// ============================================================
// Path: apps/api/prisma/schema.prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
}

enum StudyMood {
  HAPPY
  NEUTRAL
  SAD
}

enum GoalType {
  DAILY
  WEEKLY
  MONTHLY
}

enum BadgeCode {
  FIRST_STUDY_ENTRY
  SEVEN_DAY_STREAK
  THIRTY_DAY_STREAK
  HUNDRED_HOURS
  MATH_HERO
  SCIENCE_EXPLORER
  CONSISTENCY_CHAMPION
  CHAPTER_FINISHER
  EARLY_BIRD
  NIGHT_OWL
}

// ============================================================
// USER
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  fullName        String
  passwordHash    String
  classLevel      Int
  avatarUrl       String?
  role            UserRole  @default(STUDENT)

  xp              Int       @default(0)
  level           Int       @default(1)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastStudyDate   DateTime? @db.Date

  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  isProfilePublic Boolean   @default(true)

  googleId        String?   @unique

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  subjects        Subject[]
  studyEntries    StudyEntry[]
  goals           Goal[]
  badges          UserBadge[]
  otpTokens       OtpToken[]
  refreshTokens   RefreshToken[]
  diaries         StudyDiary[]

  // === NEW relations (Step 19) ===
  ownedGroups             Group[]                    @relation("GroupOwner")
  groupMemberships        GroupMember[]
  sentInvitations         GroupInvitation[]          @relation("Inviter")
  receivedInvitations     GroupInvitation[]          @relation("Invitee")
  notifications           Notification[]
  conversationParticipants ConversationParticipant[]
  messages                Message[]

  @@index([email])
  @@index([username])
}

// ============================================================
// OTP TOKEN (Email verification + Password reset)
// ============================================================

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model OtpToken {
  id        String     @id @default(cuid())
  userId    String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  consumed  Boolean    @default(false)
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([code])
}

// ============================================================
// REFRESH TOKEN (Device session management)
// ============================================================

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  rememberMe Boolean  @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// SUBJECT
// ============================================================

model Subject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#A78BFA")
  icon      String   @default("📚")
  isCustom  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyEntries StudyEntry[]
  goals        Goal[]

  @@unique([userId, name])
  @@index([userId])
}

// ============================================================
// STUDY ENTRY (Daily study log)
// ============================================================

model StudyEntry {
  id              String    @id @default(cuid())
  userId          String
  subjectId       String
  date            DateTime  @db.Date
  durationMinutes Int
  chapter         String?
  note            String?   @db.Text
  mood            StudyMood @default(NEUTRAL)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, subjectId])
  @@index([subjectId])
}

// ============================================================
// GOAL
// ============================================================

model Goal {
  id             String   @id @default(cuid())
  userId         String
  subjectId      String?
  title          String
  type           GoalType
  targetMinutes  Int?
  targetChapters Int?
  progressValue  Int      @default(0)
  isCompleted    Boolean  @default(false)
  startsAt       DateTime @db.Date
  endsAt         DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([userId, startsAt, endsAt])
}

// ============================================================
// BADGE
// ============================================================

model UserBadge {
  id       String    @id @default(cuid())
  userId   String
  code     BadgeCode
  earnedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
}

// ============================================================
// STUDY DIARY (Personal notes / feelings)
// ============================================================

model StudyDiary {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  @db.Date
  content   String    @db.Text
  mood      StudyMood @default(NEUTRAL)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ============================================================
// Path: apps/api/prisma/schema.prisma
// (existing schema এর শেষে যোগ করো — existing models/types মুছবে না)
// ============================================================

// ============================================================
// ENUMS (new)
// ============================================================

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NotificationType {
  GROUP_INVITATION
  GROUP_INVITATION_ACCEPTED
  GROUP_JOINED
  GROUP_LEFT
  GROUP_MESSAGE
  PERSONAL_MESSAGE
  GROUP_TARGET_COMPLETED
  GROUP_MEMBER_MILESTONE
  BADGE_EARNED
}

enum MessageType {
  TEXT
  IMAGE
}

// ============================================================
// GROUP
// ============================================================

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  imageUrl    String?
  ownerId     String
  isMuted     Boolean  @default(false) // owner global mute flag (optional use)

  // Group-wide study target (optional)
  weeklyTargetMinutes Int?
  weeklyTargetChapters Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User               @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  invitations GroupInvitation[]
  conversation Conversation?

  @@index([ownerId])
}

// ============================================================
// GROUP MEMBER
// ============================================================

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(MEMBER)
  isMuted   Boolean   @default(false) // user-level mute in this group
  joinedAt  DateTime  @default(now())

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ============================================================
// GROUP INVITATION
// ============================================================

model GroupInvitation {
  id          String           @id @default(cuid())
  groupId     String
  inviterId   String
  inviteeId   String
  status      InvitationStatus @default(PENDING)
  message     String?          @db.Text
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  expiresAt   DateTime

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter     User             @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User             @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([groupId])
  @@unique([groupId, inviteeId, status])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json?            // extra context: { groupId, invitationId, senderId, conversationId, ... }
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ============================================================
// CONVERSATION (1-on-1 or group chat)
// ============================================================

model Conversation {
  id        String   @id @default(cuid())
  // null if personal (1-on-1), set if group chat
  groupId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group        Group?                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

// ============================================================
// CONVERSATION PARTICIPANT
// ============================================================

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

// ============================================================
// MESSAGE
// ============================================================

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  content        String?      @db.Text   // text content (null if image-only)
  imageUrl       String?                 // image path
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}