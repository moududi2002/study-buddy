{
  "name": "study-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "শিক্ষার্থীদের পড়াশোনার সঙ্গী - Study Buddy Monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "pnpm --filter @study-buddy/api prisma:migrate",
    "db:generate": "pnpm --filter @study-buddy/api prisma:generate",
    "db:studio": "pnpm --filter @study-buddy/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}